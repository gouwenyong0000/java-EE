<?xml version="1.0" encoding="UTF-8"?>
<!--
    instrument-client 日志配置

    配置顺序说明（自上而下，从基础到高级）：
      1. property        — 定义全局属性（如日志文件路径）
      2. appender        — 定义日志输出目的地（控制台/文件）
      3. logger          — 定义具体包的日志级别和输出行为
      4. root            — 定义根日志记录器（所有 logger 的兜底）

    层级结构：
      root (根日志记录器)
        └── logger "com.example.cli" (具体包)
              └── logger "com.example.cli.engine"
                    └── ...

    继承规则：
      - 所有 logger 默认继承 root 的 appender（additivity=true）
      - logger 设置了 level 会覆盖 root 的 level（不会向上继承）
      - 子 logger 可以通过 additivity="false" 阻断向上传播
-->
<configuration>

    <!-- ==================== 1. 全局属性定义 ==================== -->
    <property name="LOG_FILE" value="logs/instrument-client.log"/>

    <!-- ==================== 2. Appender 定义（输出目的地）==================== -->
    <!--
        CONSOLE 控制台输出：
        - 格式：[时间] [线程名] 级别 日志名 - 消息
        - 适用：开发调试时实时查看
    -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!--
        FILE 滚动文件输出：
        - 按天 + 按大小滚动（单个文件最大 10MB）
        - 保留 30 天历史日志
        - 总容量上限 1GB（超出则删除最旧文件）
        - 适用：生产环境问题排查
    -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_FILE}</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>logs/instrument-client.%d{yyyy-MM-dd}.%i.log</fileNamePattern>
            <maxFileSize>10MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%d{yyyy-MM-dd HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- ==================== 3. Logger 定义（具体包级别）==================== -->
    <!--
        logger 与 root 的关系：

        ① 继承 appender：
           - logger 默认 additivity=true，会向上传播到 root
           - 因此 com.example.cli 的日志会同时输出到 CONSOLE 和 FILE
           - 如需单独输出（如只输出到文件），可设置 additivity="false"

        ② 覆盖 level：
           - logger 设置了 level=DEBUG，不会继承 root 的 INFO
           - 而是使用自己显式配置的 DEBUG 级别

        ③ 层级匹配：
           - logger "com.example.cli" 匹配 com.example.cli.* 所有类
           - 子包（如 engine、protocol）会继承父 logger 的配置

        日志级别说明：
        - DEBUG：协议编解码细节、信号量时序、帧切分、粘包处理等
        - INFO ：连接成功/失败、命令发送、响应接收等生命周期事件
        - WARN ：队列满丢帧、写失败重连、心跳超时等可恢复异常
        - ERROR：连接彻底失败、协议解析错误等严重问题

        环境调整建议：
        - 开发调试：level="DEBUG"
        - 生产运行：level="INFO"（减少日志量，提升性能）
        - 问题排查：level="TRACE"（最详细的帧级日志）
    -->
    <logger name="com.example.cli" level="DEBUG"/>

    <!-- ==================== 4. Root 定义（兜底日志记录器）==================== -->
    <!--
        root 是所有 logger 的兜底：
        - 当某个包没有显式配置 logger 时，使用 root 的配置
        - 第三方库（如 SLF4J 自身）默认使用 root 级别（INFO）

        appender-ref 说明：
        - CONSOLE：控制台输出，方便实时查看
        - FILE    ：文件输出，支持滚动（按天/按大小），保留 30 天，最高 1GB
    -->
    <root level="INFO">
        <appender-ref ref="CONSOLE"/>
        <appender-ref ref="FILE"/>
    </root>

</configuration>